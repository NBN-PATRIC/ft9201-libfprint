#!/bin/bash
# Guarda para o PAM: a digital so' e' aceita na tela de bloqueio se a carteira
# do KDE JA' estiver aberta.
#
# Por que: a carteira so' abre com a senha em texto claro, que o pam_fprintd nao
# fornece (o pam_kwallet deriva a chave do PAM_AUTHTOK, que so' o pam_unix
# preenche). Como esta maquina usa autologin, a carteira nasce FECHADA e so'
# abre no primeiro desbloqueio. Se esse primeiro desbloqueio for por digital,
# ela nunca abre -- e o gate start-after-secretservice.sh segura para sempre os
# apps que dependem do Secret Service (OmniRoute, app do Claude).
#
# Medido: bloquear a tela NAO fecha a carteira (118 bloqueios num dia, mesmo PID
# do kwalletd6). Logo isto so' morde uma vez por boot.
#
# CRITICO -- nao ativar o kwalletd6 por D-Bus.
# 'gdbus call --dest org.kde.kwalletd6' ATIVA o servico se ele nao estiver de
# pe'. Em 2026-07-30 isso quebrou o boot inteiro: no primeiro bloqueio este
# guarda subia o kwalletd6 SEM o socket que o pam_kwallet usa para entregar a
# chave; o usuario digitava a senha, o pam_kwallet5 rodava auth+setcred e nao
# tinha por onde passar a chave, e a carteira nunca abria. Sem cofre, o app do
# Claude ficava preso no gate e este guarda passava a recusar a digital para
# sempre. NameHasOwner responde sem ativar nada.
#
# Sai 0 (permite digital) so' quando a carteira esta' comprovadamente aberta.
set -u

u="${PAM_USER:-}"
[ -n "$u" ] || exit 1

uid=$(id -u "$u" 2>/dev/null) || exit 1
bus="/run/user/$uid/bus"
[ -S "$bus" ] || exit 1

# Roda um gdbus SEMPRE no bus de sessao do usuario. Sob o PAM isto executa como
# root e precisa baixar de privilegio; rodando a mao para testar, ja' se e' o
# usuario e o runuser recusaria.
no_bus_do_usuario() {
  if [ "$(id -u)" -eq 0 ] && [ "$(id -u)" -ne "$uid" ]; then
    runuser -u "$u" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" "$@" 2>/dev/null
  else
    DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" "$@" 2>/dev/null
  fi
}

# 1) o daemon esta' de pe' por conta propria? (nao ativa)
[ "$(no_bus_do_usuario gdbus call --session --dest org.freedesktop.DBus \
      --object-path /org/freedesktop/DBus \
      --method org.freedesktop.DBus.NameHasOwner org.kde.kwalletd6)" = "(true,)" ] || exit 1

# 2) so' entao perguntar se a carteira esta' aberta
[ "$(no_bus_do_usuario gdbus call --session --dest org.kde.kwalletd6 \
      --object-path /modules/kwalletd6 \
      --method org.kde.KWallet.isOpen kdewallet)" = "(true,)" ]
